# ---------------------------------------------------------------------------
# Ticket Booking System — environment variables
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# All variables are validated at startup by src/env.ts (fail-fast).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Public base URL of the app (used for links in emails, QR ticket URLs, CORS).
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime. On Neon this is the "-pooler"
# host (PgBouncer, transaction mode). Locally it is a plain Postgres URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketing?schema=public
# Direct (non-pooled) connection used by Prisma Migrate and by transactions
# that hold session-scoped locks / LISTEN-NOTIFY. On Neon this is the direct host.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ticketing?schema=public

# --- Authentication --------------------------------------------------------
# Secret used to sign JWT access/refresh tokens. MUST be >= 32 chars, random.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-characters
# Access token lifetime (seconds). Default 15 minutes.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime (seconds). Default 7 days.
REFRESH_TOKEN_TTL_SECONDS=604800

# --- Domain configuration (seat holds / offers) ----------------------------
# Seat hold time-to-live in seconds (default 10 minutes). Used from Phase 4.
HOLD_TTL_SECONDS=600
# Waitlist offer time-to-live in seconds (default 10 minutes). Used from Phase 8.
OFFER_TTL_SECONDS=600

# --- Background jobs -------------------------------------------------------
# Shared secret required by /api/cron/* endpoints (Vercel Cron). Used from Phase 7.
CRON_SECRET=replace-me-with-a-random-cron-secret

# --- Email (Resend) — used from Phase 9 ------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Ticketing <tickets@example.com>"

# --- QR signing — used from Phase 9 ----------------------------------------
# Separate key for signing opaque QR ticket tokens.
QR_SIGNING_KEY=replace-me-with-a-random-qr-signing-secret
